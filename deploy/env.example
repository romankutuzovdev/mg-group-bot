TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

POLL_INTERVAL_MINUTES=30
MAX_PAGES=0

# VPS / headless: HEADLESS=true + CHROME_HEADLESS_CDP=1
# Windows always-on Chrome+VPN: HEADLESS=false + CHROME_HEADLESS_CDP=0
HEADLESS=true
CHROME_HEADLESS_CDP=1
CHROME_USE_BOT_PROFILE=1
CHROME_ALLOW_KILL=0
# off = не сбрасывать вкладки после лота (сессия Copart живёт)
CHROME_RESTART_AFTER_LOT=off

CRM_PORT=8080
CRM_HOST=127.0.0.1

GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=

NGROK_AUTHTOKEN=
NGROK_DOMAIN=
